# 线上部署用的环境变量模板
#
# 用法：
#   cp .env.production.example .env     # 填好下面的值
#   node tools/ops/deploy.mjs --publish  # 目录（含 .env）整体上传
#
# 只有「平台没有环境变量面板、靠上传目录后直接 node server.js」的部署才需要这个文件；
# 有面板的部署直接在面板里填同样的键即可，.env 不是必需的。
#
# .env 不会进 git（见 .gitignore），也不要贴到 issue / 截图里。

NODE_ENV=production
PORT=8787
HOST=0.0.0.0

# ------------------------------------------------------------ 反向代理
# 线上跑在托管网关后面，必须开，否则所有用户共用一个 IP 的限流桶
TRUST_PROXY=1
# 收紧跨域：只允许前端 Pages 域名
ALLOW_ORIGINS=https://hex1um.github.io

# ---------------------------------------------------------------- 存储
# 线上保持 JSON 引擎：deploy 的「先同步再覆盖」流程依赖 data/db.json。
# 切 SQLite 之前请先跑 tools/ops/migrate-json-to-sqlite.mjs，并确认部署会带上 .sqlite 文件。
DB_ENGINE=json
DB_MIRROR_JSON=1
BACKUP_KEEP=14

# ---------------------------------------------------------------- 邮件
# 填了 SMTP_* 或 RESEND_API_KEY 就会真发验证码；全空则退回日志模式（需管理员手工转发）
MAIL_PROVIDER=smtp
MAIL_FROM=数海晴岸 <no-reply@your-domain.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# 或者用 Resend：
# MAIL_PROVIDER=resend
# RESEND_API_KEY=

# ---------------------------------------------------------------- AI
# 站点共享 Key（可选）。不填则用户只能用自己的 Key / 浏览器直连免费通道 / 本地讲解。
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_API_KEY=
