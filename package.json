{
  "name": "math-vault",
  "version": "2.5.2",
  "private": true,
  "description": "数海晴岸：高等数学好题收藏室 + 期末突击（微积分 / 习概 / C 语言 / 综合英语 / 四级 / 六级科目包）",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "smoke": "node tools/verify/smoke.mjs",
    "test": "node tools/verify/smoke.mjs",
    "test:sqlite": "node tools/verify/smoke.mjs --engine=sqlite",
    "test:all": "node tools/verify/smoke.mjs && node tools/verify/smoke.mjs --engine=sqlite",
    "check:robust": "node tools/verify/robustness-check.mjs",
    "check:katex": "node tools/verify/check-katex.mjs --max-fail=0",
    "check:store": "node tools/verify/store-test.mjs",
    "check:mail": "node tools/verify/mail-test.mjs",
    "check:env": "node tools/verify/env-test.mjs",
    "gate": "node tools/import/gate.mjs",
    "tags:migrate": "node tools/import/migrate-tags.mjs",
    "import": "node tools/import/import-problems.mjs",
    "build:pages": "node tools/ops/build-pages.mjs",
    "admin": "node tools/ops/create-admin.mjs",
    "backup": "node tools/ops/backup-db.mjs",
    "export:batch": "node tools/ops/export-batch.mjs",
    "migrate:sqlite": "node tools/ops/migrate-json-to-sqlite.mjs",
    "deploy": "node tools/ops/deploy.mjs",
    "check:ops": "node tools/verify/ops-reset-test.mjs",
    "check:http": "node tools/verify/http-test.mjs",
    "check:md": "node tools/verify/md-test.mjs",
    "check:mathkey": "node tools/verify/mathkey-test.mjs",
    "check:components": "node tools/verify/components-test.mjs",
    "check:fsrs": "node tools/verify/fsrs-test.mjs",
    "check:pages": "node tools/ops/check-pages.mjs",
    "check:dedup": "node tools/verify/dedup-problems.mjs --self-test",
    "check:delims": "node tools/verify/check-unclosed-delims.mjs --strict",
    "check:equiv": "node tools/verify/math-equiv-test.mjs",
    "merge:instances": "node tools/ops/merge-instances.mjs",
    "repair:delims": "node tools/ops/repair-missing-delims.mjs",
    "check:sprint": "node tools/verify/calc-pack-test.mjs",
    "repair:problems": "node tools/ops/repair-problems.mjs",
    "build:calc-pack": "node tools/import/build-calculus-pack.mjs"
  },
  "engines": {
    "node": ">=22.5"
  },
  "license": "MIT"
}
