# 数海晴岸 · 环境变量示例
# 复制成 .env 手动 source，或直接把变量写进部署平台的环境变量面板。
# 所有变量都可不配：不配就是「单机 JSON + 验证码写日志 + 不限来源」的本地开发形态。

# ---------------------------------------------------------------- 基础
PORT=8787
HOST=0.0.0.0
SITE_NAME=数海晴岸
NODE_ENV=production

# ------------------------------------------------------------ 反向代理
# 线上在反向代理（托管网关 / Nginx / Cloudflare）后面时必须开，
# 否则 clientIp() 只能看到代理 IP，所有用户共用一个限流桶：
# 登录 12 次/分、AI 40 次/10 分、投稿 20 次/10 分……
# 只有确认「最外层就是自己的代理」时才开，否则客户端可以伪造 X-Forwarded-For 绕过限流。
TRUST_PROXY=1

# 允许跨域访问的来源，逗号分隔。线上务必收紧，不要留 *
ALLOW_ORIGINS=https://hex1um.github.io

# ---------------------------------------------------------------- 存储
# json（默认）| sqlite（推荐：行级增量落盘，不再每次全量序列化）
DB_ENGINE=sqlite
# 库文件；sqlite 引擎下这是镜像用的 JSON 路径，真正的库是同名 .sqlite
DB_FILE=./data/db.json
# sqlite 引擎是否继续导出 db.json（sync-live / deploy / robustness-check 依赖它）
DB_MIRROR_JSON=1
DB_MIRROR_INTERVAL_MS=300000
# OFF | NORMAL | FULL：NORMAL 在「进程崩溃不丢数据」与写入速度之间取平衡
DB_SQLITE_SYNC=NORMAL
# 备份保留天数（data/backups/daily）
BACKUP_KEEP=14

# ---------------------------------------------------------------- 邮件
# 不配置任何一项 → 日志模式：验证码只写服务端日志，管理员手工转发
# resend | http | smtp | log
MAIL_PROVIDER=smtp
MAIL_FROM=数海晴岸 <no-reply@your-domain.com>

# SMTP（587 走 STARTTLS，465 直连 TLS）
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=robot@example.com
SMTP_PASS=
# 465 端口或服务商要求时设 true
SMTP_SECURE=false
SMTP_HELO=
SMTP_TIMEOUT=15000

# Resend（HTTP API）
RESEND_API_KEY=

# 自建 HTTP 邮件网关：POST {from,to,subject,text}
MAIL_HTTP_URL=
MAIL_HTTP_TOKEN=

# ---------------------------------------------------------------- AI
# 站点共享 Key（可选）。不配则只有浏览器直连免费通道 + 本地讲解。
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_API_KEY=
DEEPSEEK_API_KEY=
# 自建 LLM 域名需要加进白名单（只填域名，不带协议）
LLM_ALLOWED_HOSTS=
# 设 1 可关闭 Pollinations 免费公共通道
NO_FREE=

# ------------------------------------------------------------ 运维脚本
# tools/ops/sync-live.mjs 与 deploy.mjs 必须显式提供，脚本不内置任何凭据
SHARECODE=
ADMIN_USER=
ADMIN_PASS=
BASE=https://math-vault-10141.app.workbuddy.host
